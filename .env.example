# Copy to .env (repo root). Read by docker compose for variable substitution.

# Postgres password; must match DATABASE_URL in server/.env.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# LiveKit API key pair, as "key: secret"; must match LIVEKIT_API_KEY /
# LIVEKIT_API_SECRET in server/.env.
# Generate with: echo "API$(openssl rand -hex 6): $(openssl rand -hex 24)"
LIVEKIT_KEYS=APIxxxxxxxxxxxx: CHANGE_ME
