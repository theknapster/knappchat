# Copy to server/.env (see DEPLOYMENT.md)

# Postgres (docker-compose.yml). The password must match POSTGRES_PASSWORD in
# the repo-root .env.
DATABASE_URL=postgres://knappchat:CHANGE_ME@localhost:5433/knappchat

# Session JWT signing secret - any long random string
JWT_SECRET=change-me-to-a-long-random-string

# LiveKit (must match LIVEKIT_KEYS in the repo-root .env)
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=CHANGE_ME
# Browser-facing signaling URL
LIVEKIT_URL=wss://livekit.example.com
# Server-side API URL
LIVEKIT_HTTP_URL=http://localhost:7880

# Mail. Typical provider: port 465 with SMTP_SECURE=true, and the mailbox's
# full address + password as SMTP_USER / SMTP_PASS. Leave SMTP_USER empty
# for an unauthenticated relay.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_FROM=noreply@example.com
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Base URL the app is served from (used to build magic-link callback URLs)
APP_URL=https://example.com

# 127.0.0.1 behind a reverse proxy; defaults to 0.0.0.0
HOST=127.0.0.1
PORT=8080
